services:
  tailscale:
    image: tailscale/tailscale:latest
    hostname: iikanji-account
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - tailscale-state:/var/lib/tailscale
    environment:
      - TS_USERSPACE=false
      - TS_STATE_DIR=/var/lib/tailscale
    networks:
      - internal
    restart: unless-stopped

  web:
    image: ghcr.io/nananek/iikanji-kakeibo:4.3.2
    # distroless 版 (シェルなし / 非 root uid 65532) に差し替える場合はこちら。
    # 同じタグ体系で `-distroless` を付けたイメージを公開している。
    # 差し替える際は vouchers ボリュームの所有者を 65532:65532 に合わせること。
    # image: ghcr.io/nananek/iikanji-kakeibo:4.3.2-distroless
    network_mode: service:tailscale
    environment:
      - TZ=Asia/Tokyo
      # ローカル LLM (llama.cpp / llama-server) を提供したい場合のみ設定。
      # 未設定なら UI から llama.cpp 選択肢が消える。
      # - LLAMA_CPP_URL=http://llama-server:8080
    volumes:
      # 証憑画像。コンテナは非 root (alpine 版は app ユーザー uid 100、
      # distroless 版は uid 65532) で動作する。新規ボリュームはイメージの
      # 所有者を引き継ぐが、既存の root 所有ボリュームや、alpine 版で作った
      # ボリュームを distroless 版で使う場合は一度 chown が必要:
      #   docker run --rm -v iikanji-kakeibo_vouchers:/v alpine \
      #     chown -R 100:101 /v          # alpine 版 (uid 100)
      #   docker run --rm -v iikanji-kakeibo_vouchers:/v alpine \
      #     chown -R 65532:65532 /v      # distroless 版 (uid 65532)
      - vouchers:/app/data/vouchers
    env_file:
      - .env
    depends_on:
      tailscale:
        condition: service_started
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    volumes:
      - pgdata:/var/lib/postgresql/data
    env_file:
      - .env
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 5

networks:
  internal:

volumes:
  pgdata:
  tailscale-state:
  vouchers:
