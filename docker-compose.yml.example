services:
  tailscale:
    image: tailscale/tailscale:latest
    hostname: iikanji-account
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - tailscale-state:/var/lib/tailscale
    environment:
      - TS_USERSPACE=false
      - TS_STATE_DIR=/var/lib/tailscale
    networks:
      - internal
    restart: unless-stopped

  web:
    image: ghcr.io/nananek/iikanji-kakeibo:4.3.0
    network_mode: service:tailscale
    environment:
      - TZ=Asia/Tokyo
      # ローカル LLM (llama.cpp / llama-server) を提供したい場合のみ設定。
      # 未設定なら UI から llama.cpp 選択肢が消える。
      # - LLAMA_CPP_URL=http://llama-server:8080
    volumes:
      # 証憑画像。コンテナは非 root (alpine の app ユーザー, uid 100) で
      # 動作する。新規ボリュームはイメージの所有者を引き継ぐが、既存の
      # root 所有ボリュームを引き継ぐ場合は一度 chown が必要:
      #   docker run --rm -v iikanji-kakeibo_vouchers:/v alpine \
      #     chown -R 100:101 /v
      - vouchers:/app/data/vouchers
    env_file:
      - .env
    depends_on:
      tailscale:
        condition: service_started
      db:
        condition: service_healthy

  db:
    image: postgres:16-alpine
    volumes:
      - pgdata:/var/lib/postgresql/data
    env_file:
      - .env
    networks:
      - internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 5

networks:
  internal:

volumes:
  pgdata:
  tailscale-state:
  vouchers:
