FLASK_APP=app
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret-key
DATABASE_URL=postgresql://iikanji:iikanji@db:5432/iikanji
POSTGRES_USER=iikanji
POSTGRES_PASSWORD=iikanji
POSTGRES_DB=iikanji
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=いいかんじ™家計簿
WEBAUTHN_ORIGIN=http://localhost:5000

# --- セキュリティ / セッション ---
# 本番 (HTTPS) では PREFERRED_URL_SCHEME=https を設定すると、セッション
# および永続ログイン (remember) Cookie に Secure 属性が自動付与される。
# 明示的に上書きする場合は SESSION_COOKIE_SECURE=true/false を設定する。
# PREFERRED_URL_SCHEME=https
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=Lax

# リクエストボディの最大サイズ (バイト)。未設定なら 25 MiB。
# 上限がないと巨大アップロードでメモリを枯渇させられるため必ず設定する。
# MAX_CONTENT_LENGTH=26214400

# --- CAPTCHA (optional) ---
# Supported: hcaptcha, recaptcha, turnstile, mcaptcha
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SITE_KEY=your-site-key
# CAPTCHA_SECRET_KEY=your-secret-key
# CAPTCHA_API_URL=https://mcaptcha.example.com  # mCaptcha only
