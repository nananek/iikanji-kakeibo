services:
  web:
    image: ghcr.io/nananek/iikanji-kakeibo:2.1.0
    ports:
      - "5000:5000"
    env_file:
      - .env
    depends_on:
      db:
        condition: service_healthy

  scheduler:
    image: ghcr.io/nananek/iikanji-kakeibo:2.1.0
    entrypoint: []
    command: ["sh", "-c", "while true; do sleep ${AUTO_IMPORT_INTERVAL:-1800}; flask auto-import; done"]
    env_file:
      - .env
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  db:
    image: postgres:16-alpine
    volumes:
      - pgdata:/var/lib/postgresql/data
    env_file:
      - .env
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 5

volumes:
  pgdata:
